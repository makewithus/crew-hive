# CrewHive shared Express API — environment (example; never commit real values)
APP_ENV=development                 # production | staging | development | test
PORT=4000

# Firebase. FIREBASE_MODE: live | emulator.  (mock exists ONLY for APP_ENV=test and is set by the test runner.)
FIREBASE_MODE=live
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_WEB_API_KEY=               # public web API key, used server-side to exchange custom tokens / refresh sessions
# Emulator mode only:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Auth / OTP
OTP_PEPPER=                         # >=16 random chars (required in production)
OTP_DEV_ECHO=false                  # true = return the OTP in the API response; refused in production
FIREBASE_TEST_PHONE=+919876543210   # Development-only test phone number (refused in production)
FIREBASE_TEST_OTP=123456            # Development-only fixed test OTP (refused in production)
SUPER_ADMIN_PHONE=                  # bootstrap super admin(s); server-side only
ADMIN_PHONES=                       # optional comma list (super-admin level bootstrap)

# Delivery providers (BLOCKED BY EXTERNAL DEPENDENCY until credentials/templates are approved)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=CRWHIV
MSG91_WHATSAPP_NUMBER=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=

# HTTP
CORS_ORIGINS=http://localhost:3000  # comma list of web origins (required in production)
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=30
