# CrewHive website — environment (example)
# Public (browser-visible) — never put secrets here
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000      # the shared Express backend (public URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Server-only
EXPRESS_API_URL=http://localhost:4000               # used by the /api/* proxy routes (may be an internal URL)

# TRANSITIONAL — only the WhatsApp conversational webhook (not yet migrated) still uses the Admin SDK:
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=
